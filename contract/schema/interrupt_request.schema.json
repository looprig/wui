{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looprig.dev/sessionwire/v1/interrupt_request.schema.json",
  "title": "InterruptRequest",
  "description": "Retry-safe durable interrupt command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command_id", "session_id"],
  "properties": {
    "version": {"const": 1},
    "command_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "description": "Opaque UTF-8 identity; Core enforces the 256-byte limit."}
  }
}
