{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looprig.dev/sessionwire/v1/input_request.schema.json",
  "title": "InputRequest",
  "description": "Retry-safe durable input command. Block semantics remain transport-neutral and are validated by the receiving runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command_id", "session_id", "blocks"],
  "properties": {
    "version": {"const": 1},
    "command_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "blocks": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "description": "Opaque UTF-8 identity; Core enforces the 256-byte limit."}
  }
}
